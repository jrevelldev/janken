/* Display3Manager.uss - Vertical Display 3 (1080x1920 Portrait) Styling */

.display3-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #F7F4EB;
    color: #FFFFFF;
    flex-direction: column;
    overflow: hidden;
    position: relative;
}

/* ROTATED BACKGROUND IMAGE: 90 DEGREES CLOCKWISE SO RED CIRCLE IS AT THE BOTTOM */
.display3-bg-rotated {
    position: absolute;
    width: 1920px;
    height: 1080px;
    top: 420px;
    left: -420px;
    background-image: url('project:/Assets/Sprites/Backgrounds/Background.png');
    -unity-background-scale-mode: scale-and-crop;
    rotate: 90deg;
    transform-origin: center center;
    picking-mode: Ignore;
    z-index: 0;
}

.display2-hidden {
    display: none;
}

/* VIEW CONTAINER FOR VERTICAL DISPLAY */
.display2-view-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
}

.display3-upper-view-container {
    justify-content: flex-start !important;
    align-items: center !important;
    padding-top: 220px !important;
}

.display2-bracket-scroll {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center !important;
    justify-content: flex-start !important;
    padding-top: 60px;
    overflow: hidden;
}

.display2-bracket-centered {
    justify-content: flex-start !important;
    align-items: center !important;
    align-self: center !important;
    margin-left: 0px;
    margin-top: 20px;
    padding-left: 0px;
    padding-right: 0px;
}

/* ANIMATED BRACKET CONTAINER IN UPPER HALF */
.bracket-container {
    flex-direction: row;
    align-items: flex-start !important;
    justify-content: center !important;
    transition-property: translate, opacity;
    transition-duration: 0.6s;
    transition-timing-function: ease-out;
    translate: 0px 0px;
    opacity: 1;
    scale: 0.9 0.9;
    transform-origin: top center;
}

.bracket-hidden {
    translate: 0px -80px;
    opacity: 0;
}

/* BRACKET ROUND HEADERS WITH RED BRUSH BACKGROUND */
.round-header {
    width: 200px;
    height: 44px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #FFFFFF;
    -unity-text-align: middle-center;
    align-self: center;
    padding-top: 8px;
    padding-bottom: 4px;
    background-image: url('project:/Assets/Sprites/UI/Header_Brush_Red.png');
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0px;
    margin-bottom: 18px;
    letter-spacing: 1px;
}

/* FINAL ROUND ANIMATED GOLD RIBBON BANNER & CROWN */
.final-banner-crown {
    width: 210px;
    height: 90px;
    background-image: url('project:/Assets/Sprites/UI/Final_Banner_Crown.png');
    -unity-background-scale-mode: scale-to-fit;
    align-self: center;
    margin-bottom: -15px;
    transition-property: translate, opacity, scale;
    transition-duration: 0.65s;
    transition-timing-function: ease-out-back;
    translate: 0px 0px;
    scale: 1 1;
    opacity: 1;
    picking-mode: Ignore;
    z-index: 80;
}

.final-banner-hidden {
    translate: 0px -160px;
    scale: 0.7 0.7;
    opacity: 0;
}

/* MATCH CARDS IN BRACKET */
.match-card {
    height: 84px;
    background-color: #12100E;
    border-radius: 14px;
    border-width: 3px;
    border-color: #D4AF37;
    overflow: hidden;
    transition-duration: 0.2s;
}

.match-card-completed {
    border-color: #D91E28;
    border-width: 3px;
}

.match-card:hover {
    border-color: #F2C94C;
}

.match-slot {
    height: 42px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 14px;
    padding-right: 12px;
    background-color: #FFFDF8;
    border-bottom-width: 2px;
    border-bottom-color: rgba(74, 64, 56, 0.4);
    transition-duration: 0.15s;
}

.match-slot-winner {
    background-color: #D91E28 !important;
    border-left-width: 6px;
    border-left-color: #F2C94C;
}

.match-slot-winner .slot-player-name {
    color: #FFFFFF !important;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
}

.match-slot-loser {
    opacity: 0.9;
    background-color: #161412 !important;
}

.match-slot-loser .slot-player-name {
    color: #FFFFFF !important;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
}

.slot-player-name {
    font-size: 17px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #141210;
    flex-grow: 1;
}

.slot-score {
    font-size: 16px;
    -unity-font-style: bold;
    color: #F2C94C;
    width: 24px;
    text-align: center;
}

/* CONNECTOR LINES */
.connector-arm {
    position: absolute;
    background-color: #D91E28;
}

.connector-arm-active {
    background-color: #F2C94C;
}

/* COMBAT VS VIEW STYLING FOR VERTICAL DISPLAY (P1 TOP, VS CENTER, P2 BOTTOM) */
.combat-round-title {
    font-size: 26px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #FFFFFF;
    background-image: url('project:/Assets/Sprites/UI/Header_Brush_Red.png');
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0px;
    padding: 14px 60px;
    margin-top: 0px;
    margin-bottom: 24px;
    text-align: center;
    letter-spacing: 2px;
}

.combat-stage {
    flex-direction: row; /* SIDE-BY-SIDE HORIZONTALLY IN VERTICAL DISPLAY */
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-bottom: 20px;
    position: relative;
}

/* PLAYER CARD FOR VERTICAL DISPLAY (SIDE BY SIDE: WIDTH 380PX EACH) */
.combat-player-card {
    width: 380px;
    height: 410px;
    background-color: #161412;
    border-radius: 24px;
    border-width: 4px;
    border-color: #D4AF37;
    align-items: center;
    justify-content: center;
    padding: 24px;
    scale: 1 1;
    translate: 0px 0px;
    opacity: 1;
    z-index: 10;
    transition-property: translate, scale, border-color, background-color, opacity;
    transition-duration: 0.55s;
    transition-timing-function: ease-out-back;
}

/* VERTICAL DISPLAY 3: P1 FROM LEFT, P2 FROM RIGHT */
.p1-card-hidden {
    translate: -600px 0px;
    opacity: 0;
}

.p2-card-hidden {
    translate: 600px 0px;
    opacity: 0;
}

.p1-card {
    border-color: #D4AF37;
    background-color: #161412;
}

.p2-card {
    border-color: #D4AF37;
    background-color: #161412;
}

/* WINNER POP-OUT & LOSER DIM ANIMATIONS */
.combat-card-winner {
    scale: 1.06 1.06;
    border-width: 5px !important;
    border-color: #F2C94C !important;
    background-color: #8E161C !important;
    z-index: 15;
}

.combat-card-winner .player-avatar-circle {
    border-color: #F2C94C !important;
    background-color: #D91E28 !important;
}

.combat-card-winner .combat-player-status {
    background-color: #F2C94C !important;
    color: #12100E !important;
    -unity-font-style: bold;
}

.combat-card-loser {
    scale: 0.92 0.92;
    opacity: 0.4 !important;
    border-color: #4A4038 !important;
}

.combat-card-loser .combat-player-status {
    background-color: #38312C !important;
    color: #C2B7A5 !important;
}

/* AVATAR CIRCLE */
.player-avatar-circle {
    width: 130px;
    height: 130px;
    border-radius: 65px;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    border-width: 4px;
    transition-duration: 0.35s;
}

.p1-avatar {
    background-color: #D91E28;
    border-color: #F2C94C;
}

.p2-avatar {
    background-color: #1E3A8A;
    border-color: #F2C94C;
}

.player-avatar-initials {
    font-size: 52px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

.combat-player-seed {
    font-size: 14px;
    -unity-font-style: bold;
    color: #12100E;
    background-color: #F2C94C;
    padding: 3px 12px;
    border-radius: 12px;
    margin-bottom: 10px;
}

.combat-player-name {
    font-size: 38px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #FFFFFF;
    margin-bottom: 12px;
    text-align: center;
}

.combat-player-status {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #FFFFFF;
    background-image: url('project:/Assets/Sprites/UI/Header_Brush_Red.png');
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0px;
    padding: 6px 26px;
    transition-duration: 0.35s;
}

/* VS BRUSH BADGE IMAGE IN VERTICAL DISPLAY (LARGER & Z-INDEX IN FRONT) */
.vs-emblem-container {
    width: 250px;
    height: 220px;
    background-image: url('project:/Assets/Sprites/UI/VS_Brush_Badge.png');
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent;
    border-width: 0px;
    align-items: center;
    justify-content: center;
    margin-left: -50px;
    margin-right: -50px;
    z-index: 50;
    transition-property: scale, opacity;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-back;
    scale: 1 1;
    opacity: 1;
}

.vs-emblem-hidden {
    scale: 0 0;
    opacity: 0;
}

.vs-emblem-text {
    display: none;
}

.vs-pulse-ring {
    display: none;
}

/* CHAMPION STAGE VERTICAL */
.champion-stage {
    align-items: center;
    justify-content: center;
    padding: 48px 40px;
    background-color: rgba(22, 20, 18, 0.96);
    border-width: 5px;
    border-color: #F2C94C;
    border-radius: 28px;
    width: 680px;
}

.champion-huge-trophy {
    font-size: 110px;
    margin-bottom: 16px;
}

.champion-stage-subtitle {
    font-size: 26px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #F2C94C;
    letter-spacing: 2px;
    margin-bottom: 18px;
}

.champion-stage-name {
    font-size: 42px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #FFFFFF !important;
    background-image: url('project:/Assets/Sprites/UI/Header_Brush_Red.png');
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0px;
    padding: 18px 72px;
    margin-bottom: 24px;
    text-align: center;
    -unity-text-align: middle-center;
    align-self: center;
    letter-spacing: 2px;
}

.champion-stage-footer {
    font-size: 18px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #C2B7A5;
}

/* CHROMA KEY BACKGROUND OVERRIDE */
.display2-chroma-bg {
    background-image: none !important;
    background-color: #00ff00 !important;
}

.display2-chroma-bg .display3-bg-rotated {
    display: none !important;
}

/* SINGLE ROUND FOCUS VIEW */
.round-focus-title {
    font-size: 26px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #FFFFFF;
    background-image: url('project:/Assets/Sprites/UI/Header_Brush_Red.png');
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0px;
    padding: 14px 56px;
    margin-bottom: 28px;
    align-self: center;
    letter-spacing: 2px;
}

.single-round-container {
    justify-content: center;
    align-items: center;
    align-self: center;
}

.single-round-column {
    align-items: center;
    justify-content: center;
}

/* STREET FIGHTER VERTICAL HUD OVERLAY (CHROMA KEY MODE) */
.sf-overlay-view {
    justify-content: center !important;
    align-items: center !important;
}

.sf-hud-bar {
    width: 84%;
    height: 520px;
    background-color: rgba(18, 16, 14, 0.96);
    border-radius: 24px;
    border-width: 4px;
    border-color: #D91E28;
    flex-direction: column; /* VERTICAL SF HUD BAR */
    align-items: center;
    justify-content: space-between;
    padding: 28px;
}

.sf-player-card {
    flex-direction: row;
    align-items: center;
}

.sf-p1-card {
    flex-direction: row;
    align-items: center;
}

.sf-p2-card {
    flex-direction: row;
    align-items: center;
}

.sf-avatar-box {
    width: 76px;
    height: 76px;
    border-radius: 38px;
    border-width: 3px;
    border-color: #F2C94C;
    align-items: center;
    justify-content: center;
    margin-left: 14px;
    margin-right: 14px;
}

.sf-p1-card .sf-avatar-box {
    background-color: #D91E28;
}

.sf-p2-card .sf-avatar-box {
    background-color: #1E3A8A;
}

.sf-avatar-initials {
    font-size: 30px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #FFFFFF;
}

.sf-player-name {
    font-size: 34px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #FFFFFF;
}

.sf-vs-center {
    align-items: center;
    justify-content: center;
}

.sf-round-title {
    font-size: 18px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #F2C94C;
    margin-bottom: 6px;
}

.sf-vs-text {
    font-size: 40px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #D91E28;
}

/* REFEREE ANIMATED CHARACTER (SLIDES IN FROM LEFT TO RIGHT - LARGER SIZE) */
.referee-character {
    position: absolute;
    bottom: -35px;
    align-self: center;
    width: 850px;
    height: 920px;
    background-image: url('project:/Assets/Sprites/UI/Referee_Character.png');
    -unity-background-scale-mode: scale-to-fit;
    transition-property: translate, opacity;
    transition-duration: 0.65s;
    transition-timing-function: ease-out-back;
    translate: 0px 0px;
    opacity: 1;
    picking-mode: Ignore;
    z-index: 90;
}

.referee-hidden {
    translate: -1000px 0px; /* SLIDES IN FROM LEFT TO RIGHT */
    opacity: 0;
    transition-duration: 0.35s;
    transition-timing-function: ease-in;
}

/* STINGER TRANSITION OVERLAY */
.stinger-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: stretch-to-fill;
    picking-mode: Ignore;
    z-index: 100;
}
