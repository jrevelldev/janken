/* Display2Manager.uss - Girocòmic JANKEN Official Anime & Pop Styling */

.display2-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-image: url('project:/Assets/Sprites/Backgrounds/Background.png');
    -unity-background-scale-mode: scale-and-crop;
    background-color: #F7F4EB;
    color: #FFFFFF;
    flex-direction: column;
}

.display2-hidden {
    display: none;
}

/* VIEW CONTAINER */
.display2-view-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.display2-bracket-scroll {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: flex-start !important;
    justify-content: center !important;
    overflow: hidden;
}

.display2-bracket-centered {
    justify-content: flex-start !important;
    align-items: flex-start !important;
    align-self: flex-start !important;
    margin-left: 45px;
    padding-left: 0px;
    padding-right: 0px;
}

/* ANIMATED BRACKET CONTAINER */
.bracket-container {
    flex-direction: row;
    align-items: flex-start !important;
    justify-content: flex-start !important;
    transition-property: translate, opacity;
    transition-duration: 0.6s;
    transition-timing-function: ease-out;
    translate: 0px 0px;
    opacity: 1;
}

.bracket-hidden {
    translate: -80px 0px;
    opacity: 0;
}

/* BRACKET ROUND HEADERS WITH RED BRUSH BACKGROUND & PERMANENT MARKER FONT */
.round-header {
    min-width: 240px;
    height: 48px;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #FFFFFF;
    -unity-text-align: middle-center;
    align-self: center;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 4px;
    padding-bottom: 4px;
    background-image: url('project:/Assets/Sprites/UI/Header_Brush_Red.png');
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0px;
    margin-bottom: 18px;
    letter-spacing: 0px;
    white-space: nowrap;
}

/* FINAL ROUND ANIMATED GOLD RIBBON BANNER & CROWN */
.final-banner-crown {
    width: 210px;
    height: 90px;
    background-image: url('project:/Assets/Sprites/UI/Final_Banner_Crown.png');
    -unity-background-scale-mode: scale-to-fit;
    align-self: center;
    margin-bottom: -15px;
    transition-property: translate, opacity, scale;
    transition-duration: 0.65s;
    transition-timing-function: ease-out-back;
    translate: 0px 0px;
    scale: 1 1;
    opacity: 1;
    picking-mode: Ignore;
    z-index: 80;
}

.final-banner-hidden {
    translate: 160px 0px;
    scale: 0.7 0.7;
    opacity: 0;
}

/* MATCH CARDS IN DISPLAY 2 BRACKET (PRONOUNCED BORDERS & BOLDER TEXT) */
.match-card {
    height: 108px;
    background-color: #12100E;
    border-radius: 14px;
    border-width: 3px;
    border-color: #D4AF37;
    overflow: hidden;
    transition-duration: 0.2s;
}

.match-card-completed {
    border-color: #D91E28;
    border-width: 3px;
}

.match-card:hover {
    border-color: #F2C94C;
}

.match-slot {
    height: 54px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 14px;
    padding-right: 12px;
    background-color: #FFFDF8;
    border-bottom-width: 2px;
    border-bottom-color: rgba(74, 64, 56, 0.4);
    transition-duration: 0.15s;
}

.match-slot:hover {
    background-color: #F5EFE0;
}

.match-slot-winner {
    background-color: #D91E28 !important;
    border-left-width: 6px;
    border-left-color: #F2C94C;
}

.match-slot-winner .slot-player-name {
    color: #FFFFFF !important;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
}

.match-slot-loser {
    opacity: 0.9;
    background-color: #161412 !important;
}

.match-slot-loser .slot-player-name {
    color: #FFFFFF !important;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
}

.match-slot-empty {
    background-color: #FFFDF8;
    opacity: 0.7;
}

.match-slot-empty .slot-player-name {
    color: #777777;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
}

.slot-player-name {
    font-size: 28px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #141210;
    flex-grow: 1;
    letter-spacing: 0.5px;
}

.slot-score {
    font-size: 16px;
    -unity-font-style: bold;
    color: #F2C94C;
    width: 24px;
    text-align: center;
}

/* CONNECTOR LINES (PRONOUNCED 4PX) */
.connector-arm {
    position: absolute;
    background-color: #D91E28;
}

.connector-arm-active {
    background-color: #F2C94C;
}

/* REFEREE ANIMATED CHARACTER (SLIDE IN RIGHT TO LEFT - HUGE SIZE) */
.referee-character {
    position: absolute;
    bottom: -30px;
    right: -30px;
    width: 780px;
    height: 850px;
    background-image: url('project:/Assets/Sprites/UI/Referee_Character.png');
    -unity-background-scale-mode: scale-to-fit;
    transition-property: translate, opacity;
    transition-duration: 0.65s;
    transition-timing-function: ease-out-back;
    translate: 0px 0px;
    opacity: 1;
    picking-mode: Ignore;
    z-index: 90;
}

.referee-hidden {
    translate: 880px 0px;
    opacity: 0;
    transition-duration: 0.35s;
    transition-timing-function: ease-in;
}

/* COMBAT VS VIEW STYLING WITH RED BRUSH HEADER & PERMANENT MARKER FONT */
.combat-round-title {
    font-size: 22px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #FFFFFF;
    background-image: url('project:/Assets/Sprites/UI/Header_Brush_Red.png');
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0px;
    padding: 12px 48px;
    margin-top: 24px;
    margin-bottom: 24px;
    text-align: center;
    letter-spacing: 2px;
}

.combat-stage {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin-bottom: 20px;
    position: relative;
}

/* JAPANESE CARD STYLING WHEN IDLE */
.combat-player-card {
    width: 320px;
    height: 420px;
    background-color: #161412;
    border-radius: 20px;
    border-width: 3px;
    border-color: #D4AF37;
    align-items: center;
    justify-content: center;
    padding: 20px;
    scale: 1 1;
    translate: 0px 0px;
    opacity: 1;
    z-index: 10;
    transition-property: translate, scale, border-color, background-color, opacity;
    transition-duration: 0.55s;
    transition-timing-function: ease-out-back;
}

/* HORIZONTAL DISPLAY 2: P1 FROM TOP, P2 FROM BOTTOM */
.p1-card-hidden {
    translate: 0px -600px;
    opacity: 0;
}

.p2-card-hidden {
    translate: 0px 600px;
    opacity: 0;
}

.p1-card {
    border-color: #D4AF37;
    background-color: #161412;
}

.p2-card {
    border-color: #D4AF37;
    background-color: #161412;
}

/* WINNER POP-OUT & LOSER DIM ANIMATIONS */
.combat-card-winner {
    scale: 1.08 1.08;
    border-width: 4px !important;
    border-color: #F2C94C !important;
    background-color: #8E161C !important;
    z-index: 15;
}

.combat-card-winner .player-avatar-circle {
    border-color: #F2C94C !important;
    background-color: #D91E28 !important;
}

.combat-card-winner .combat-player-status {
    background-color: transparent !important;
    background-image: none !important;
    color: #F2C94C !important;
    font-size: 32px;
}

.combat-card-loser {
    scale: 0.9 0.9;
    opacity: 0.4 !important;
    border-color: #4A4038 !important;
}

.combat-card-loser .combat-player-status {
    background-color: transparent !important;
    background-image: none !important;
    color: transparent !important;
}

/* AVATAR CIRCLE */
.player-avatar-circle {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    border-width: 4px;
    transition-duration: 0.35s;
}

.p1-avatar {
    background-color: #D91E28;
    border-color: #F2C94C;
}

.p2-avatar {
    background-color: #1E3A8A;
    border-color: #F2C94C;
}

.player-avatar-initials {
    font-size: 46px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

.combat-player-seed {
    font-size: 12px;
    -unity-font-style: bold;
    color: #12100E;
    background-color: #F2C94C;
    padding: 2px 10px;
    border-radius: 10px;
    margin-bottom: 8px;
}

.combat-player-name {
    font-size: 32px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #FFFFFF;
    margin-bottom: 12px;
    text-align: center;
}

.combat-player-status {
    font-size: 28px;
    -unity-font-style: bold;
    color: #F2C94C;
    background-image: none;
    background-color: transparent;
    border-width: 0px;
    padding: 0px;
    margin-top: 4px;
    height: 36px;
    -unity-text-align: middle-center;
    transition-duration: 0.35s;
}

/* VS BRUSH BADGE IMAGE (LARGER & Z-INDEX IN FRONT) */
.vs-emblem-container {
    width: 240px;
    height: 210px;
    background-image: url('project:/Assets/Sprites/UI/VS_Brush_Badge.png');
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent;
    border-width: 0px;
    align-items: center;
    justify-content: center;
    margin-left: -40px;
    margin-right: -40px;
    z-index: 50;
    transition-property: scale, opacity;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-back;
    scale: 1 1;
    opacity: 1;
}

.vs-emblem-hidden {
    scale: 0 0;
    opacity: 0;
}

.vs-emblem-text {
    display: none;
}

.vs-pulse-ring {
    display: none;
}

/* CHAMPION STAGE */
.champion-stage {
    align-items: center;
    justify-content: center;
    padding: 36px 30px;
    background-color: rgba(22, 20, 18, 0.96);
    border-width: 4px;
    border-color: #F2C94C;
    border-radius: 24px;
    width: 540px;
}

.champion-huge-trophy {
    font-size: 80px;
    margin-bottom: 10px;
}

.champion-stage-subtitle {
    font-size: 22px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #F2C94C;
    letter-spacing: 2px;
    margin-bottom: 14px;
}

.champion-stage-name {
    font-size: 32px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #FFFFFF !important;
    background-image: url('project:/Assets/Sprites/UI/Header_Brush_Red.png');
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0px;
    padding: 14px 56px;
    margin-bottom: 20px;
    text-align: center;
    -unity-text-align: middle-center;
    align-self: center;
    letter-spacing: 2px;
}

.champion-stage-footer {
    font-size: 15px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #C2B7A5;
}

/* CHROMA KEY BACKGROUND OVERRIDE */
.display2-chroma-bg {
    background-image: none !important;
    background-color: #00ff00 !important;
}

/* SINGLE ROUND FOCUS VIEW */
.round-focus-title {
    font-size: 24px;
    -unity-font-style: bold;
    -unity-font-definition: url('project:/Assets/UI/Fonts/PermanentMarker-Regular.ttf');
    color: #FFFFFF;
    background-image: url('project:/Assets/Sprites/UI/Header_Brush_Red.png');
    -unity-background-scale-mode: stretch-to-fill;
    background-color: transparent;
    border-width: 0px;
    padding: 12px 48px;
    margin-bottom: 24px;
    align-self: center;
    letter-spacing: 2px;
}

.single-round-container {
    justify-content: center;
    align-items: center;
    align-self: center;
}

.single-round-column {
    align-items: center;
    justify-content: center;
}

/* STREET FIGHTER TOP BAR / LOWER THIRD HUD OVERLAY (CHROMA KEY MODE) */
.sf-overlay-view {
    justify-content: flex-start !important;
    align-items: center !important;
    padding-top: 24px;
}

.sf-hud-bar {
    width: 92%;
    height: 110px;
    background-color: rgba(18, 16, 14, 0.96);
    border-radius: 20px;
    border-width: 3px;
    border-color: #D91E28;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 20px;
    padding-right: 20px;
}

.sf-p1-card {
    flex-direction: row;
    align-items: center;
    height: 75px;
    background-color: rgba(28, 25, 23, 0.95);
    border-radius: 14px;
    padding-left: 12px;
    padding-right: 20px;
    border-width: 2px;
    border-color: #D4AF37;
    min-width: 280px;
    transition-duration: 0.25s;
}

.sf-p2-card {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    height: 75px;
    background-color: rgba(28, 25, 23, 0.95);
    border-radius: 14px;
    padding-left: 20px;
    padding-right: 12px;
    border-width: 2px;
    border-color: #D4AF37;
    min-width: 280px;
    transition-duration: 0.25s;
}

.sf-avatar-box {
    width: 54px;
    height: 54px;
    border-radius: 27px;
    background-color: #D91E28;
    border-width: 2px;
    border-color: #FFFFFF;
    align-items: center;
    justify-content: center;
}

.sf-avatar-initials {
    font-size: 24px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.sf-player-name {
    font-size: 26px;
    -unity-font-style: bold;
    color: #FFFFFF;
    margin-left: 14px;
    margin-right: 14px;
}

.sf-player-seed {
    font-size: 13px;
    color: #F2C94C;
    -unity-font-style: bold;
}

.sf-player-badge {
    font-size: 14px;
    -unity-font-style: bold;
    color: #FFFFFF;
    background-color: #D91E28;
    padding: 4px 10px;
    border-radius: 8px;
    margin-left: 8px;
    margin-right: 8px;
}

.sf-vs-center {
    align-items: center;
    justify-content: center;
}

.sf-round-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #F2C94C;
    letter-spacing: 1px;
    margin-bottom: 2px;
}

.sf-vs-badge {
    width: 80px;
    height: 70px;
    background-image: url('project:/Assets/Sprites/UI/VS_Brush_Badge.png');
    -unity-background-scale-mode: scale-to-fit;
    background-color: transparent;
    border-width: 0px;
}

.sf-card-winner {
    border-color: #F2C94C !important;
    background-color: rgba(217, 30, 40, 0.45) !important;
    scale: 1.05 1.05;
}

.sf-card-winner .sf-player-badge {
    background-color: #F2C94C !important;
    color: #12100E !important;
}

.sf-card-loser {
    opacity: 0.45 !important;
}

/* STINGER ANIMATION OVERLAY */
.stinger-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: stretch-to-fill;
    transform-origin: center center;
    picking-mode: Ignore;
    z-index: 999;
}

/* CHROMA KEY BACKGROUND OVERRIDE */
.display2-chroma-bg {
    background-image: none !important;
    background-color: #00ff00 !important;
}

/* STREET FIGHTER TOP BAR / LOWER THIRD HUD OVERLAY (CHROMA KEY MODE) */
.sf-overlay-view {
    justify-content: flex-start !important;
    align-items: center !important;
    padding-top: 24px;
}

.sf-hud-bar {
