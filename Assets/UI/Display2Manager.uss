/* Display2Manager.uss - Stage & Audience View Stylesheet */

.display2-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #090d16;
    color: #f8fafc;
    flex-direction: column;
}

.display2-hidden {
    display: none;
}

/* VIEW CONTAINER */
.display2-view-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.display2-bracket-scroll {
    width: 100%;
    height: 100%;
}

.display2-bracket-scroll .unity-scroll-view__content-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    height: 100%;
}

.display2-bracket-centered {
    justify-content: center;
    align-items: flex-start;
    align-self: center;
}

/* COMBAT VS VIEW STYLING */
.combat-round-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: #f59e0b;
    margin-top: 40px;
    margin-bottom: 20px;
    text-align: center;
    letter-spacing: 2px;
}

.combat-stage {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    width: 90%;
    margin-bottom: 40px;
}

/* NEUTRAL CLEAN CARD STYLING WHEN IDLE */
.combat-player-card {
    width: 380px;
    height: 440px;
    background-color: #1e293b;
    border-radius: 20px;
    border-width: 2px;
    border-color: #334155;
    align-items: center;
    justify-content: center;
    padding: 30px;
    scale: 1 1;
    transition-property: scale, border-color, background-color, opacity;
    transition-duration: 0.35s;
}

.p1-card {
    border-color: #334155;
    background-color: #1e293b;
}

.p2-card {
    border-color: #334155;
    background-color: #1e293b;
}

/* WINNER POP-OUT & LOSER DIM ANIMATIONS */
.combat-card-winner {
    scale: 1.12 1.12;
    border-width: 4px !important;
    border-color: #f59e0b !important;
    background-color: rgba(245, 158, 11, 0.15) !important;
    z-index: 10;
}

.combat-card-winner .player-avatar-circle {
    border-color: #f59e0b !important;
    background-color: #d97706 !important;
}

.combat-card-winner .combat-player-status {
    background-color: #f59e0b !important;
    color: #0f172a !important;
    -unity-font-style: bold;
}

.combat-card-loser {
    scale: 0.88 0.88;
    opacity: 0.35 !important;
    border-color: #334155 !important;
}

.combat-card-loser .combat-player-status {
    background-color: #334155 !important;
    color: #94a3b8 !important;
}

/* AVATAR CIRCLE */
.player-avatar-circle {
    width: 130px;
    height: 130px;
    border-radius: 65px;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    border-width: 3px;
    transition-duration: 0.35s;
}

.p1-avatar {
    background-color: #334155;
    border-color: #475569;
}

.p2-avatar {
    background-color: #334155;
    border-color: #475569;
}

.player-avatar-initials {
    font-size: 54px;
    -unity-font-style: bold;
    color: #ffffff;
    -unity-text-align: middle-center;
}

.combat-player-seed {
    font-size: 14px;
    -unity-font-style: bold;
    color: #94a3b8;
    margin-bottom: 6px;
}

.combat-player-name {
    font-size: 34px;
    -unity-font-style: bold;
    color: #f8fafc;
    margin-bottom: 14px;
    text-align: center;
}

.combat-player-status {
    font-size: 14px;
    -unity-font-style: bold;
    color: #94a3b8;
    background-color: rgba(15, 23, 42, 0.8);
    padding: 6px 18px;
    border-radius: 12px;
    transition-duration: 0.35s;
}

/* VS EMBLEM */
.vs-emblem-container {
    width: 140px;
    height: 140px;
    align-items: center;
    justify-content: center;
    margin-left: 30px;
    margin-right: 30px;
}

.vs-emblem-text {
    font-size: 72px;
    -unity-font-style: bold;
    color: #f59e0b;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #78350f;
    letter-spacing: -4px;
}

.vs-pulse-ring {
    position: absolute;
    width: 120px;
    height: 120px;
    border-radius: 60px;
    border-width: 3px;
    border-color: rgba(245, 158, 11, 0.3);
}

/* CHAMPION STAGE */
.champion-stage {
    align-items: center;
    justify-content: center;
    padding: 40px;
    background-color: rgba(30, 41, 59, 0.95);
    border-width: 4px;
    border-color: #f59e0b;
    border-radius: 24px;
    width: 600px;
}

.champion-huge-trophy {
    font-size: 90px;
    margin-bottom: 10px;
}

.champion-stage-subtitle {
    font-size: 20px;
    -unity-font-style: bold;
    color: #f59e0b;
    letter-spacing: 2px;
    margin-bottom: 12px;
}

.champion-stage-name {
    font-size: 48px;
    -unity-font-style: bold;
    color: #ffffff;
    margin-bottom: 16px;
    text-align: center;
}

.champion-stage-footer {
    font-size: 16px;
    color: #94a3b8;
}

/* CHROMA KEY BACKGROUND OVERRIDE */
.display2-chroma-bg {
    background-color: #00ff00 !important;
}

/* SINGLE ROUND FOCUS VIEW */
.round-focus-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: #f59e0b;
    margin-top: 30px;
    margin-bottom: 20px;
    text-align: center;
    letter-spacing: 2px;
}

.single-round-container {
    justify-content: center;
    align-items: center;
    align-self: center;
    padding: 20px;
}

.single-round-column {
    align-items: center;
    justify-content: center;
}

/* STREET FIGHTER TOP BAR / LOWER THIRD HUD OVERLAY (CHROMA KEY MODE) */
.sf-overlay-view {
    justify-content: flex-start !important;
    align-items: center !important;
    padding-top: 24px;
}

.sf-hud-bar {
    width: 92%;
    height: 110px;
    background-color: rgba(15, 23, 42, 0.95);
    border-radius: 20px;
    border-width: 3px;
    border-color: #38bdf8;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 20px;
    padding-right: 20px;
}

.sf-p1-card {
    flex-direction: row;
    align-items: center;
    height: 75px;
    background-color: rgba(30, 41, 59, 0.95);
    border-radius: 14px;
    padding-left: 12px;
    padding-right: 20px;
    border-width: 2px;
    border-color: #475569;
    min-width: 280px;
    transition-duration: 0.25s;
}

.sf-p2-card {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    height: 75px;
    background-color: rgba(30, 41, 59, 0.95);
    border-radius: 14px;
    padding-left: 20px;
    padding-right: 12px;
    border-width: 2px;
    border-color: #475569;
    min-width: 280px;
    transition-duration: 0.25s;
}

.sf-avatar-box {
    width: 54px;
    height: 54px;
    border-radius: 27px;
    background-color: #0ea5e9;
    border-width: 2px;
    border-color: #ffffff;
    align-items: center;
    justify-content: center;
}

.sf-avatar-initials {
    font-size: 24px;
    -unity-font-style: bold;
    color: #ffffff;
}

.sf-player-name {
    font-size: 26px;
    -unity-font-style: bold;
    color: #ffffff;
    margin-left: 14px;
    margin-right: 14px;
}

.sf-player-seed {
    font-size: 12px;
    color: #94a3b8;
    -unity-font-style: bold;
}

.sf-player-badge {
    font-size: 14px;
    -unity-font-style: bold;
    color: #0f172a;
    background-color: #38bdf8;
    padding: 4px 10px;
    border-radius: 8px;
    margin-left: 8px;
    margin-right: 8px;
}

.sf-vs-center {
    align-items: center;
    justify-content: center;
}

.sf-round-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #f59e0b;
    letter-spacing: 1px;
    margin-bottom: 2px;
}

.sf-vs-text {
    font-size: 38px;
    -unity-font-style: bold;
    color: #ef4444;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #7f1d1d;
    letter-spacing: -2px;
}

.sf-card-winner {
    border-color: #f59e0b !important;
    background-color: rgba(245, 158, 11, 0.25) !important;
    scale: 1.05 1.05;
}

.sf-card-winner .sf-player-badge {
    background-color: #f59e0b !important;
    color: #0f172a !important;
}

.sf-card-loser {
    opacity: 0.45 !important;
}

/* STINGER ANIMATION OVERLAY */
.stinger-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: stretch-to-fill;
    transform-origin: center center;
    picking-mode: Ignore;
    z-index: 999;
}

