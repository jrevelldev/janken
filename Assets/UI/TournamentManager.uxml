<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="project://database/Assets/UI/TournamentManager.uss" />

    <ui:VisualElement name="Root" class="main-container">
        <!-- Sidebar Setup Panel -->
        <ui:VisualElement name="SidebarPanel" class="sidebar">
            <ui:VisualElement class="sidebar-logo" />
            <ui:Label text="CONFIGURACIÓ DEL TORNEIG" class="sidebar-title" />

            <ui:Label text="Preset Ràpid de Jugadors:" style="font-size: 12px; color: #94a3b8; margin-bottom: 4px;" />
            <ui:VisualElement class="preset-container">
                <ui:Button name="BtnPreset4" text="4 Jug." class="btn-preset" />
                <ui:Button name="BtnPreset8" text="8 Jug." class="btn-preset" />
                <ui:Button name="BtnPreset16" text="16 Jug." class="btn-preset" />
            </ui:VisualElement>

            <ui:Label text="Afegir Jugador:" style="font-size: 12px; color: #94a3b8; margin-bottom: 4px;" />
            <ui:VisualElement class="input-add-container">
                <ui:TextField name="PlayerNameInput" value="" placeholder-text="Nom del jugador..." class="player-input" />
                <ui:Button name="BtnAddPlayer" text="+" class="btn-secondary" style="font-size: 16px; width: 36px;" />
            </ui:VisualElement>

            <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 8px;">
                <ui:Label text="Llista de Participants:" style="font-size: 12px; color: #94a3b8;" />
                <ui:Button name="BtnShuffle" text="🔀 Barrejar" class="btn-secondary" style="font-size: 11px; padding: 2px 6px;" />
            </ui:VisualElement>

            <ui:ScrollView name="PlayerScrollView" class="player-scroll-list">
                <!-- Dynamic player rows inserted here -->
            </ui:ScrollView>

            <ui:Button name="BtnResetDefaults" text="🔄 Restablir Exemples" class="btn-secondary" style="margin-top: 6px; font-size: 11px;" />
            <ui:Button name="BtnGenerateBracket" text="⚡ Generar / Reiniciar Quadre" class="btn-secondary" style="margin-top: 6px; font-size: 12px; padding: 6px 10px;" />
        </ui:VisualElement>

        <!-- Main Tournament Area -->
        <ui:VisualElement class="main-tournament-area" style="flex-grow: 1; flex-shrink: 1; height: 100%; flex-direction: column; overflow: hidden;">
            <!-- Header Bar -->
            <ui:VisualElement class="top-header">
                <ui:VisualElement class="header-left-group">
                    <ui:VisualElement class="top-header-logo" />
                    <ui:Label name="TournamentTitleLabel" text="TORNEIG JANKEN" class="header-title" />
                    
                    <!-- CONTROL DISPLAY VIEWS BAR -->
                    <ui:VisualElement class="display2-control-bar-group">
                        <!-- TIER 1: STANDARD VIEWS -->
                        <ui:VisualElement class="display2-control-bar">
                            <ui:Label text="ESTÀNDARD:" class="display2-bar-label" />
                            <ui:Button name="BtnViewBracket" text="📊 Quadre" class="btn-display-view btn-display-view-active" />
                            <ui:Button name="BtnViewRound" text="🔍 Ronda" class="btn-display-view" />
                            <ui:Button name="BtnViewCombat" text="⚔️ Combat" class="btn-display-view" />
                            <ui:Button name="BtnViewChampion" text="🏆 Podi" class="btn-display-view" />
                        </ui:VisualElement>

                        <!-- TIER 2: CHROMA KEY OVERLAY VIEWS (OBS GREEN) -->
                        <ui:VisualElement class="display2-control-bar chroma-bar">
                            <ui:Label text="🟢 CROMA:" class="display2-bar-label chroma-label" />
                            <ui:Button name="BtnChromaCleanFeed" text="🟩 Verd Croma (Clean)" class="btn-display-view btn-chroma-view" tooltip="Fons 100% verd croma pur sense grafismes ni personatge (Clean Feed)" />
                            <ui:Button name="BtnChromaRound" text="🔍 Ronda Croma" class="btn-display-view btn-chroma-view" />
                            <ui:Button name="BtnChromaCombatSF" text="🥊 SF Top Bar" class="btn-display-view btn-chroma-view" />
                            <ui:Button name="BtnChromaChampion" text="🏆 Podi Croma" class="btn-display-view btn-chroma-view" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="header-right-group">
                    <!-- VIDEO ACTION BUTTONS GROUP -->
                    <ui:VisualElement class="video-action-group">
                        <ui:Button name="BtnGo" text="▶ GO" class="btn-video-action btn-video-go" tooltip="Reproduir vídeo NOU ÀRBITRE amb Stinger" />
                        <ui:Button name="BtnRep" text="🔄 REP" class="btn-video-action btn-video-rep" tooltip="Reproduir vídeo NOU ÀRBITRE directament (Sense Stinger)" />
                    </ui:VisualElement>

                    <ui:VisualElement class="header-controls">
                        <ui:Button name="BtnSwapDisplays" text="🔁 Monitors: D2 / D3" class="btn-secondary btn-swap-displays" tooltip="Clic per intercanviar l'ordre dels monitors físics de Display 2 (Horitzontal) i Display 3 (Vertical)" />
                        <ui:Toggle name="ToggleStinger" label="🎬 Stinger" value="true" class="toggle-stinger" />
                        <ui:Button name="BtnToggleMusic" text="🎵 Música" class="btn-secondary btn-music" />
                        <ui:Button name="BtnToggleSidebar" text="⚙️" class="btn-secondary btn-icon-only" tooltip="Configuració del Torneig" />
                        <ui:Button name="BtnCloseApp" text="✕" class="btn-close-app" tooltip="Tancar aplicació" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- SUB-HEADER DISPLAY STATUS & ROUND FILTER BAR -->
            <ui:VisualElement class="display2-status-banner">
                <ui:Label name="Display2StatusText" text="📺 D2 (Horitzontal): Monitor 2 | 📱 D3 (Vertical): Monitor 3" class="display2-status-text" />
                <ui:VisualElement name="RoundSelectorContainer" class="round-selector-container">
                    <!-- Dynamic round selector pill buttons inserted here via C# -->
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Bracket Container Scroll View -->
            <ui:ScrollView name="BracketScrollView" mode="Horizontal" vertical-scroller-visibility="Hidden" class="bracket-scroll-view">
                <ui:VisualElement name="BracketContainer" class="bracket-container">
                    <!-- Dynamic Round Columns & Champion card inserted here via C# -->
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- QUIT CONFIRMATION MODAL -->
        <ui:VisualElement name="ConfirmQuitModal" class="modal-overlay modal-hidden">
            <ui:VisualElement class="modal-card">
                <ui:VisualElement class="modal-header">
                    <ui:Label text="⚠️ TANCAR APLICACIÓ" class="modal-title" />
                </ui:VisualElement>
                <ui:Label text="Segur que vols tancar el programa JANKEN?" class="modal-message" />
                <ui:VisualElement class="modal-actions">
                    <ui:Button name="BtnConfirmQuitYes" text="Sí, Tancar" class="btn-modal-yes" />
                    <ui:Button name="BtnConfirmQuitNo" text="No, Cancel·lar" class="btn-modal-no" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
