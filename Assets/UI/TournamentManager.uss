/* TournamentManager.uss - Girocòmic JANKEN Japanese High-Contrast Theme */

:root {
    --bg-dark: #12100E;         /* Sumi Ink Deep Black */
    --bg-card: #1C1917;         /* High-contrast Sumi Card */
    --bg-card-hover: #2B2520;
    --bg-card-winner: #8E161C;  /* Japanese Crimson Winner */
    --border-color: #443B33;
    --accent-cyan: #D91E28;      /* Primary Accent: Japanese Crimson Red */
    --accent-purple: #D4AF37;    /* Secondary Accent: Japanese Gold */
    --accent-gold: #F2C94C;      /* Bright Gold */
    --text-primary: #FFFFFF;     /* Pure White text */
    --text-muted: #C2B7A5;       /* Muted Ochre-Gray */
    --accent-success: #D91E28;   /* Crimson Red */
    --danger-red: #D91E28;       /* Crimson Red */
}

.main-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: var(--bg-dark);
    color: var(--text-primary);
    font-size: 14px;
    flex-direction: row;
}

/* Header Bar */
.top-header {
    min-height: 68px;
    height: auto;
    background-color: #12100E;
    border-bottom-width: 2px;
    border-bottom-color: #D4AF37;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 6px;
    width: 100%;
}

.header-left-group {
    flex-direction: row;
    align-items: center;
}

.header-right-group {
    flex-direction: row;
    align-items: center;
}

.header-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: #D91E28;
    letter-spacing: 1px;
    margin-right: 12px;
}

.header-controls {
    flex-direction: row;
    align-items: center;
}

.toggle-stinger {
    margin-right: 12px;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--text-primary);
}

.toggle-stinger .unity-toggle__label {
    color: #F2C94C;
    margin-right: 6px;
}

/* Sidebar / Setup Panel */
.sidebar {
    width: 330px;
    background-color: #181513;
    border-right-width: 2px;
    border-right-color: #D4AF37;
    padding: 16px;
    flex-direction: column;
}

.sidebar-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #FFFFFF;
    margin-bottom: 12px;
    border-bottom-width: 2px;
    border-bottom-color: #D91E28;
    padding-bottom: 8px;
}

.preset-container {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 12px;
}

.btn-preset {
    flex-grow: 1;
    margin-right: 4px;
    margin-left: 4px;
    background-color: #26211E;
    color: #FFFFFF;
    border-radius: 6px;
    border-width: 1px;
    border-color: #D4AF37;
    padding: 6px 10px;
    -unity-font-style: bold;
    transition-duration: 0.15s;
}

.btn-preset:hover {
    background-color: #D91E28;
    color: #FFFFFF;
    border-color: #F2C94C;
}

.input-add-container {
    flex-direction: row;
    margin-bottom: 12px;
}

.player-input {
    flex-grow: 1;
}

.player-input .unity-text-field__input {
    background-color: #0E0C0A;
    color: #FFFFFF;
    border-radius: 6px;
    border-width: 1px;
    border-color: #D4AF37;
    padding: 6px 10px;
}

.player-input .unity-text-field__input:hover {
    border-color: #F2C94C;
}

.player-input .unity-text-field__input:focus {
    border-color: #D91E28;
    background-color: #1A1816;
    color: #FFFFFF;
}

.btn-primary {
    background-color: #D91E28;
    color: #FFFFFF;
    -unity-font-style: bold;
    border-radius: 6px;
    border-width: 1px;
    border-color: #F2C94C;
    padding: 8px 16px;
    transition-duration: 0.15s;
}

.btn-primary:hover {
    background-color: #F02430;
}

.btn-secondary {
    background-color: #2E2824;
    color: #FFFFFF;
    -unity-font-style: bold;
    border-radius: 6px;
    border-width: 1px;
    border-color: #443B33;
    padding: 8px 12px;
    margin-left: 6px;
    transition-duration: 0.15s;
}

.btn-secondary:hover {
    background-color: #443B33;
}

.btn-danger {
    background-color: var(--danger-red);
    color: white;
    -unity-font-style: bold;
    border-radius: 4px;
    border-width: 0;
    padding: 2px 6px;
}

.player-scroll-list {
    flex-grow: 1;
    margin-bottom: 12px;
}

.player-item-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: #1C1917;
    border-radius: 6px;
    padding: 8px 12px;
    margin-bottom: 6px;
    border-width: 1px;
    border-color: #38312C;
}

.player-item-seed {
    color: #F2C94C;
    -unity-font-style: bold;
    width: 28px;
}

.player-item-name {
    flex-grow: 1;
    color: var(--text-primary);
    font-size: 14px;
}

.player-item-name-input {
    flex-grow: 1;
    margin-left: 4px;
    margin-right: 4px;
}

.player-item-name-input .unity-text-field__input {
    background-color: transparent;
    color: #f8fafc;
    border-width: 0;
    font-size: 14px;
    padding: 2px 6px;
    border-radius: 4px;
}

.player-item-name-input .unity-text-field__input:hover {
    background-color: rgba(51, 65, 85, 0.5);
}

.player-item-name-input .unity-text-field__input:focus {
    background-color: #0f172a;
    border-width: 1px;
    border-color: var(--accent-cyan);
    color: #f8fafc;
}

/* Bracket Scroll View */
.bracket-scroll-view {
    flex-grow: 1;
    height: 100%;
    padding: 20px;
}

.bracket-container {
    flex-direction: row;
    align-items: flex-start;
    padding-top: 10px;
    padding-bottom: 60px;
}

.round-column {
    width: 260px;
    flex-direction: column;
    align-items: stretch;
}

.connector-column {
    width: 32px;
    flex-direction: column;
    align-items: stretch;
}

.round-header {
    height: 36px;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--accent-purple);
    text-align: center;
    padding-top: 8px;
    background-color: rgba(30, 41, 59, 0.8);
    border-radius: 6px;
    margin-bottom: 20px;
    border-bottom-width: 2px;
    border-bottom-color: var(--accent-purple);
    transition-duration: 0.15s;
}

.round-header:hover {
    background-color: var(--accent-purple);
    color: #ffffff;
}

/* Match Card */
.match-card {
    height: 80px;
    background-color: var(--bg-card);
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--border-color);
    overflow: hidden;
    transition-duration: 0.2s;
}

/* Connector Line Styling */
.connector-arm {
    position: absolute;
    background-color: #475569;
}

.connector-arm-active {
    background-color: var(--accent-cyan);
}

.match-card:hover {
    border-color: var(--accent-cyan);
}

.match-card-completed {
    border-color: var(--accent-cyan);
}

.match-slot {
    height: 40px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 10px;
    padding-right: 8px;
    padding-top: 0px;
    padding-bottom: 0px;
    background-color: rgba(30, 41, 59, 0.7);
    border-bottom-width: 1px;
    border-bottom-color: rgba(51, 65, 85, 0.4);
    transition-duration: 0.15s;
}

.match-slot:hover {
    background-color: var(--bg-card-hover);
}

.match-slot-winner {
    background-color: rgba(6, 182, 212, 0.2);
    border-left-width: 4px;
    border-left-color: var(--accent-cyan);
}

.match-slot-loser {
    opacity: 0.5;
}

.match-slot-empty {
    opacity: 0.4;
}

.slot-player-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--text-primary);
    flex-grow: 1;
}

.slot-score {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--accent-gold);
    width: 24px;
    text-align: center;
}

/* Star Win Buttons */
.btn-star-idle {
    width: 28px;
    height: 28px;
    background-color: transparent;
    color: var(--text-muted);
    font-size: 16px;
    border-width: 0;
    padding: 0px;
    margin: 0px;
    -unity-text-align: middle-center;
    transition-duration: 0.15s;
}

.btn-star-idle:hover {
    color: var(--accent-gold);
    background-color: rgba(245, 158, 11, 0.15);
    border-radius: 4px;
}

.btn-star-winner {
    width: 28px;
    height: 28px;
    background-color: rgba(245, 158, 11, 0.25);
    color: var(--accent-gold);
    font-size: 16px;
    border-width: 1px;
    border-color: var(--accent-gold);
    border-radius: 4px;
    padding: 0px;
    margin: 0px;
    -unity-text-align: middle-center;
    transition-duration: 0.15s;
}

.btn-star-winner:hover {
    background-color: rgba(245, 158, 11, 0.4);
}

.btn-win-slot {
    background-color: var(--accent-cyan);
    color: #0f172a;
    -unity-font-style: bold;
    font-size: 11px;
    border-radius: 4px;
    border-width: 0;
    padding: 3px 8px;
    margin-left: 6px;
}

.btn-win-slot:hover {
    background-color: #38bdf8;
}

/* Champion Panel */
.champion-container {
    width: 280px;
    justify-content: center;
    align-items: center;
}

.champion-card {
    background-color: rgba(30, 41, 59, 0.95);
    border-width: 2px;
    border-color: var(--accent-gold);
    border-radius: 12px;
    padding: 24px;
    align-items: center;
    width: 100%;
}

.champion-icon {
    font-size: 40px;
    margin-bottom: 8px;
}

.champion-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--accent-gold);
    margin-bottom: 8px;
}

.champion-name {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--text-primary);
    text-align: center;
}

/* Control Display 2 Bar Group in Header */
.display2-control-bar-group {
    flex-direction: column;
    justify-content: center;
}

.display2-control-bar {
    flex-direction: row;
    align-items: center;
    background-color: rgba(30, 41, 59, 0.8);
    border-radius: 6px;
    padding: 3px 8px;
    border-width: 1px;
    border-color: var(--border-color);
    margin-bottom: 3px;
}

.chroma-bar {
    background-color: rgba(15, 23, 42, 0.9);
    border-color: rgba(6, 182, 212, 0.4);
    margin-bottom: 0px;
}

.chroma-label {
    color: #f59e0b !important;
}

.display2-bar-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--accent-cyan);
    margin-right: 6px;
}

.btn-display-view {
    background-color: #334155;
    color: var(--text-muted);
    font-size: 11px;
    -unity-font-style: bold;
    border-radius: 5px;
    border-width: 0;
    padding: 4px 10px;
    margin-left: 3px;
    margin-right: 3px;
    transition-duration: 0.15s;
}

.btn-display-view:hover {
    background-color: #475569;
    color: var(--text-primary);
}

.btn-display-view-active {
    background-color: var(--accent-purple);
    color: #ffffff;
    border-width: 1px;
    border-color: #a855f7;
}

.btn-chroma-view {
    background-color: #1e293b;
    color: #cbd5e1;
    font-size: 11px;
    border-width: 1px;
    border-color: rgba(6, 182, 212, 0.3);
}

.btn-chroma-view:hover {
    background-color: #0284c7;
    color: #ffffff;
}

.display2-status-banner {
    height: 36px;
    background-color: rgba(6, 182, 212, 0.12);
    border-bottom-width: 1px;
    border-bottom-color: rgba(6, 182, 212, 0.3);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 20px;
    padding-right: 20px;
}

.display2-status-text {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--accent-cyan);
}

.round-selector-container {
    flex-direction: row;
    align-items: center;
}

.btn-round-pill {
    background-color: #334155;
    color: #cbd5e1;
    font-size: 11px;
    -unity-font-style: bold;
    border-radius: 12px;
    border-width: 0;
    padding: 3px 10px;
    margin-left: 4px;
    transition-duration: 0.15s;
}

.btn-round-pill:hover {
    background-color: #475569;
    color: #ffffff;
}

.btn-round-pill-active {
    background-color: var(--accent-gold);
    color: #0f172a;
    -unity-font-style: bold;
}

.btn-match-send-combat {
    width: 32px;
    height: 76px;
    background-color: rgba(30, 41, 59, 0.9);
    color: var(--text-muted);
    font-size: 16px;
    border-width: 0;
    border-right-width: 1px;
    border-right-color: var(--border-color);
    border-top-left-radius: 7px;
    border-bottom-left-radius: 7px;
    padding: 0px;
    margin: 0px;
    -unity-text-align: middle-center;
    transition-duration: 0.15s;
}

.btn-match-send-combat:hover {
    background-color: #ffffff;
    color: #0f172a;
}

.btn-match-send-combat:focus {
    background-color: rgba(30, 41, 59, 0.9);
    color: var(--text-muted);
}

.btn-match-send-combat-active {
    background-color: #0284c7 !important;
    color: #ffffff !important;
}

.btn-match-send-combat-active:hover {
    background-color: #ffffff !important;
    color: #0f172a !important;
}

.btn-music {
    background-color: #334155;
    color: var(--text-primary);
    -unity-font-style: bold;
    border-radius: 6px;
    padding: 6px 12px;
    transition-duration: 0.15s;
}

.btn-music:hover {
    background-color: #475569;
}

.btn-music-active {
    background-color: var(--accent-purple) !important;
    color: #ffffff !important;
    border-width: 1px;
    border-color: #a855f7;
}

/* Video Action Buttons (GO & REP) - Outside nav arrays & larger */
.video-action-group {
    flex-direction: row;
    align-items: center;
    margin-left: 12px;
    margin-right: 12px;
}

.btn-video-action {
    height: 42px;
    padding-left: 16px;
    padding-right: 16px;
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 8px;
    border-width: 2px;
    margin-left: 4px;
    margin-right: 4px;
    transition-duration: 0.15s;
    -unity-text-align: middle-center;
}

.btn-video-go {
    background-color: #dc2626;
    color: #ffffff;
    border-color: #ef4444;
}

.btn-video-go:hover {
    background-color: #ef4444;
    border-color: #fca5a5;
}

.btn-video-rep {
    background-color: #2563eb;
    color: #ffffff;
    border-color: #3b82f6;
}

.btn-swap-displays {
    background-color: #334155;
    color: #f8fafc;
    border-color: #64748b;
    border-width: 1px;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
    -unity-font-style: bold;
    margin-right: 8px;
    transition-duration: 0.15s;
}

.btn-swap-displays:hover {
    background-color: #475569;
    border-color: #38bdf8;
    color: #38bdf8;
}





