# Standard .gitignore for Unity projects

/[L|l]ibrary/
/[T|t]emp/
/[O|o]bj/
/[B|b]uild/
/[B|b]uilds/
/[L|l]ogs/
/[U|u]ser[S|s]ettings/
/[M|m]emoryCaptures/
/[R|r]ecordings/

# Asset store packages
/[A|a]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin files in Unity project
/[A|a]ssets/Plugins/Editor/JetBrains*

# Visual Studio / VS Code / IDE solution & project files
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D Generated Files
sysinfo.txt

# Builds & Packages
*.apk
*.aab
*.unitypackage
*.app

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
